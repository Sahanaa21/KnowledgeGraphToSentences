       triples_str = \" | \".join(entry['triples'])\n","        # WebNLG can have multiple lexicalizations. We'll pair the triples input with each target response (one-to-many expansion)\n","        for target in entry['lexicalizations']:\n","            formatted_list.append({\n","                'instruction': instruction_text,\n","                'input': triples_str,\n","                'output': target\n","            })\n","    return formatted_list\n","\n","train_formatted = format_data(train_data)\n","dev_formatted = format_data(dev_data)\n","test_formatted = format_data(test_data)\n","\n","print(f\"Total Train Formatted Pairs: {len(train_formatted)}\")\n","print(f\"Total Dev Formatted Pairs: {len(dev_formatted)}\")\n","print(f\"Total Test Formatted Pairs: {len(test_formatted)}\")\n","\n","if train_formatted:\n","    print(\"\\nSample Formatted Train Pair:\")\n","    for k, v in train_formatted[0].items():\n","        print(f\"{k.upper()}:\\n{v}\\n\")"],"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["Total Train Formatted Pairs: 2\n","Total Dev Formatted Pairs: 2\n","Total Test Formatted Pairs: 2\n","\n","Sample Formatted Train Pair:\n","INSTRUCTION:\n","Translate the following structured RDF triples into a fluent and grammatically correct natural language sentence.\n","\n","INPUT:\n","Aarhus_Airport | location | Tirstrup\n","\n","OUTPUT:\n","Aarhus Airport is located in Tirstrup.\n","\n"]}]},{"cell_type":"markdown","metadata":{"id":"a71fbfb7"},"source":["**Reasoning**:\n","Create the custom WebNLGDataset and collate_fn with tiktoken tokenization and prompt-masking labels for PyTorch DataLoader creation.\n","\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"38f8cce2","executionInfo":{"status":"ok","timestamp":1793543072950,"user_tz":-330,"elapsed":1752,"user":{"displayName":"Sahana","userId":"04785986170074206494"}},"outputId":"69f99d13-d6c2-474d-c226-ca9e8746c82f"},"source":["import torch\n","from torch.utils.data import Dataset, DataLoader\n","import tiktoken\n","\n","# 1. Initialize tiktoken gpt2 tokenizer\n","tokenizer = tiktoken.get_encoding(\"gpt2\")\n","# Define end-of-text token id (typically 50256)\n","eot_token_id = tokenizer.eot_token\n","\n","# 2. Define Dataset Class\n","class WebNLGDataset(Dataset):\n","    def __init__(self, formatted_data):\n","        self.data = formatted_data\n","        self.template = (\n","            \"Below is an instruction that describes a task, paired with an input that provides further context. \"\n","            \"Write a response that appropriately completes the request.\\n\\n\"\n","            \"### Instruction:\\n{instruction}\\n\\n\"\n","            \"### Input:\\n{input}\\n\\n\"\n","            \"### Response:\\n\"\n","        )\n","\n","    def __len__(self):\n","        return len(self.data)\n","\n","    def __getitem__(self, idx):\n","        item = self.data[idx]\n","        prompt = self.template.format(instruction=item['instruction'], input=item['input'])\n","        response = item['output']\n","        full_text = prompt + response\n","        return {\n","            'full_text': full_text,\n","            'prompt': prompt,\n","            'response': response\n","        }\n","\n","# 3. Define Custom Collate Function with -100 masking\n","def collate_fn(batch):\n","    full_texts = [item['full_text'] for item in batch]\n","    prompts = [item['prompt'] for item in batch]\n","\n","    # Tokenize full texts and prompts\n","    tokenized_fulls = [tokenizer.encode(t, allowed_special={'<|endoftext|>'}) + [eot_token_id] for t in full_texts]\n","    tokenized_prompts = [tokenizer.encode(p, allowed_special={'<|endoftext|>'}) for p in prompts]\n","\n","    # Find maximum length in batch\n","    max_len = max(len(ids) for ids in tokenized_fulls)\n","\n","    input_ids_list = []\n","    labels_list = []\n","    attention_mask_list = []\n","\n","    for full_ids, prompt_ids in zip(tokenized_fulls, tokenized_prompts):\n","        seq_len = len(full_ids)\n","        prompt_len = len(prompt_ids)\n","\n","        # Padding\n","        padding_len = max_len - seq_len\n","        padded_input = full_ids + [eot_token_id] * padding_len\n","\n","        # Create labels: replace prompt tokens with -100, and pad tokens with -100\n","        labels = [-100] * prompt_len + full_ids[prompt_len:] + [-100] * padding_len\n","\n","        # Attention mask\n","        attn_mask = [1] * seq_len + [0] * padding_len\n","\n","        input_ids_list.append(padded_input)\n","        labels_list.append(labels)\n","        attention_mask_list.append(attn_mask)\n","\n","    return {\n","        'input_ids': torch.tensor(input_ids_list, dtype=torch.long),\n","        'labels': torch.tensor(labels_list, dtype=torch.long),\n","        'attention_mask': torch.tensor(attention_mask_list, dtype=torch.long)\n","    }\n","\n","# 4. Instantiate Datasets and DataLoaders\n","train_dataset = WebNLGDataset(train_formatted)\n","dev_dataset = WebNLGDataset(dev_formatted)\n","test_dataset = WebNLGDataset(test_formatted)\n","\n","train_loader = DataLoader(train_dataset, batch_size=2, shuffle=True, collate_fn=collate_fn)\n","dev_loader = DataLoader(dev_dataset, batch_size=2, shuffle=False, collate_fn=collate_fn)\n","test_loader = DataLoader(test_dataset, batch_size=2, shuffle=False, collate_fn=collate_fn)\n","\n","# Quick test\n","sample_batch = next(iter(train_loader))\n","print(\"Input IDs shape:\", sample_batch['input_ids'].shape)\n","print(\"Labels shape:\", sample_batch['labels'].shape)\n","print(\"Attention Mask shape:\", sample_batch['attention_mask'].shape)\n","print(\"First sample Input IDs:\\n\", sample_batch['input_ids'][0])\n","print(\"First sample Labels (masked prompt with -100):\\n\", sample_batch['labels'][0])"],"execution_count":28,"outputs":[{"output_type":"stream","name":"stdout","text":["Input IDs shape: torch.Size([2, 89])\n","Labels shape: torch.Size([2, 89])\n","Attention Mask shape: torch.Size([2, 89])\n","First sample Input IDs:\n"," tensor([21106,   318,   281, 12064,   326,  8477,   257,  4876,    11, 20312,\n","          351,   281,  5128,   326,  3769,  2252,  4732,    13, 19430,   257,\n","         2882,   326, 20431, 32543,   262,  2581,    13,   198,   198, 21017,\n","        46486,    25,   198,  8291, 17660,   262,  1708, 20793,   371,  8068,\n","         1333,  2374,   656,   257, 43472,   290, 14599, 49454,  3376,  3288,\n","         3303,  6827,    13,   198,   198, 21017, 23412,    25,   198,    32,\n","          283,  7537,    62, 16170,   634,   930,  4067,   930,   309,   667,\n","        12618,   198,   198, 21017, 18261,    25,   198,    32,   283,  7537,\n","        12690,   318,  5140,   287,   309,   667, 12618,    13, 50256])\n","First sample Labels (masked prompt with -100):\n"," tensor([ -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,  -100,\n","         -100,  -100,  -100,  -100,  -100,  -100,  -100,    32,   283,  7537,\n","        12690,   318,  5140,   287,   309,   667, 12618,    13, 50256])\n"]}]},{"cell_type":"markdown","metadata":{"id":"0b69cd72"},"source":["## Tokenization and Dataset Creation\n","\n","### Subtask:\n","Build a custom PyTorch Dataset using the tiktoken tokenizer and implement a custom collate function that applies target prompt masking with -100 for causal LLM training.\n"]},{"cell_type":"markdown","metadata":{"id":"9613b723"},"source":["## Custom GPT-2 Architecture Construction\n","\n","### Subtask:\n","Implement the complete GPT-2 (124M) transformer architecture from scratch in PyTorch.\n"]},{"cell_type":"markdown","metadata":{"id":"6c9e5163"},"source":["**Reasoning**:\n","Implement the complete GPT-2 (124M) transformer architecture from scratch in PyTorch following the provided instructions.\n","\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"d7b74695","executionInfo":{"status":"ok","timestamp":1793543107859,"user_tz":-330,"elapsed":6467,"user":{"displayName":"Sahana","userId":"04785986170074206494"}},"outputId":"e2928434-a228-4e64-b60b-0bad02f1ca20"},"source":["import math\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","# 1. Configuration Class\n","class GPTConfig:\n","    vocab_size = 50257\n","    n_positions = 1024\n","    n_embd = 768\n","    n_layer = 12\n","    n_head = 12\n","    layer_norm_epsilon = 1e-5\n","    initializer_range = 0.02\n","\n","# 2. Multi-Head Causal Self-Attention\n","class CausalSelfAttention(nn.Module):\n","    def __init__(self, config):\n","        super().__init__()\n","        assert config.n_embd % config.n_head == 0\n","        # Key, query, value projections for all heads, but in a batch\n","        self.c_attn = nn.Linear(config.n_embd, 3 * config.n_embd)\n","        # Output projection\n","        self.c_proj = nn.Linear(config.n_embd, config.n_embd)\n","        # Regularization\n","        self.n_head = config.n_head\n","        self.n_embd = config.n_embd\n","        # Causal mask\n","        self.register_buffer(\"bias\", torch.tril(torch.ones(config.n_positions, config.n_positions))\n","                                     .view(1, 1, config.n_positions, config.n_positions))\n","\n","    def forward(self, x):\n","        B, T, C = x.size() # Batch size, sequence length, embedding dimensionality (n_embd)\n","        # Calculate query, key, values for all heads in batch and move head forward to be the batch dim\n","        q, k, v  = self.c_attn(x).split(self.n_embd, dim=2)\n","        k = k.view(B, T, self.n_head, C // self.n_head).transpose(1, 2) # (B, nh, T, hs)\n","        q = q.view(B, T, self.n_head, C // self.n_head).transpose(1, 2) # (B, nh, T, hs)\n","        v = v.view(B, T, self.n_head, C // self.n_head).transpose(1, 2) # (B, nh, T, hs)\n","\n","        # Causal self-attention; Self-attend: (B, nh, T, hs) x (B, nh, hs, T) -> (B, nh, T, T)\n","        att = (q @ k.transpose(-2, -1)) * (1.0 / math.sqrt(k.size(-1)))\n","        att = att.masked_fill(self.bias[:,:,:T,:T] == 0, float('-inf'))\n","        att = F.softmax(att, dim=-1)\n","        y = att @ v # (B, nh, T, T) x (B, nh, T, hs) -> (B, nh, T, hs)\n","        y = y.transpose(1, 2).contiguous().view(B, T, C) # Re-assemble all head outputs side-by-side\n","\n","        # Output projection\n","        y = self.c_proj(y)\n","        return y\n","\n","# 3. Feed-Forward Network Block (MLP)\n","class MLP(nn.Module):\n","    def __init__(self, config):\n","        super().__init__()\n","        self.c_fc    = nn.Linear(config.n_embd, 4 * config.n_embd)\n","        self.c_proj  = nn.Linear(4 * config.n_embd, config.n_embd)\n","        # GPT-2 uses GELU with approximation\n","        self.act     = nn.GELU(approximate='tanh')\n","\n","    def forward(self, x):\n","        x = self.c_fc(x)\n","        x = self.act(x)\n","        x = self.c_proj(x)\n","        return x\n","\n","# 4. GPT-2 Block\n","class Block(nn.Module):\n","    def __init__(self, config):\n","        super().__init__()\n","        self.ln_1 = nn.LayerNorm(config.n_embd, eps=config.layer_norm_epsilon)\n","        self.attn = CausalSelfAttention(config)\n","        self.ln_2 = nn.LayerNorm(config.n_embd, eps=config.layer_norm_epsilon)\n","        self.mlp = MLP(config)\n","\n","    def forward(self, x):\n","        x = x + self.attn(self.ln_1(x))\n","        x = x + self.mlp(self.ln_2(x))\n","        return x\n","\n","# 5. Complete GPT-2 Model\n","class GPT2LMHeadModel(nn.Module):\n","    def __init__(self, config):\n","        super().__init__()\n","        self.config = config\n","\n","        self.transformer = nn.ModuleDict(dict(\n","            wte = nn.Embedding(config.vocab_size, config.n_embd),\n","            wpe = nn.Embedding(config.n_positions, config.n_embd),\n","            h = nn.ModuleList([Block(config) for _ in range(config.n_layer)]),\n","            ln_f = nn.LayerNorm(config.n_embd, eps=config.layer_norm_epsilon),\n","        ))\n","        self.lm_head = nn.Linear(config.n_embd, config.vocab_size, bias=False)\n","\n","        # Weight sharing / tying between embedding and head\n","        self.transformer.wte.weight = self.lm_head.weight\n","\n","        # Initialize weights\n","        self.apply(self._init_weights)\n","        print(f\"Custom GPT-2 model initialized successfully with {self.get_num_params():,} parameters!\")\n","\n","    def get_num_params(self):\n","        return sum(p.numel() for p in self.parameters())\n","\n","    def _init_weights(self, module):\n","        if isinstance(module, nn.Linear):\n","            torch.nn.init.normal_(module.weight, mean=0.0, std=self.config.initializer_range)\n","            if module.bias is not None:\n","                torch.nn.init.zeros_(module.bias)\n","        elif isinstance(module, nn.Embedding):\n","            torch.nn.init.normal_(module.weight, mean=0.0, std=self.config.initializer_range)\n","\n","    def forward(self, input_ids, labels=None, attention_mask=None):\n","        device = input_ids.device\n","        b, t = input_ids.size()\n","        assert t <= self.config.n_positions, f\"Cannot forward sequence of length {t}, maximum sequence length is {self.config.n_positions}\"\n","        pos = torch.arange(0, t, dtype=torch.long, device=device)\n","\n","        # Token and position embeddings\n","        tok_emb = self.transformer.wte(input_ids) # (b, t, n_embd)\n","        pos_emb = self.transformer.wpe(pos) # (t, n_embd)\n","        x = tok_emb + pos_emb\n","\n","        # Forward pass through transformer blocks\n","        for block in self.transformer.h:\n","            x = block(x)\n","        x = self.transformer.ln_f(x)\n","\n","        # Predict logits\n","        logits = self.lm_head(x) # (b, t, vocab_size)\n","\n","        # Compute loss if labels are provided\n","        loss = None\n","        if labels is not None:\n","            # Shift logits and labels by 1 to compute causal language modeling loss\n","            shift_logits = logits[..., :-1, :].contiguous()\n","            shift_labels = labels[..., 1:].contiguous()\n","            loss = F.cross_entropy(shift_logits.view(-1, shift_logits.size(-1)), shift_labels.view(-1), ignore_index=-100)\n","\n","        return {\"logits\": logits, \"loss\": loss}\n","\n","# Verification\n","config = GPTConfig()\n","model = GPT2LMHeadModel(config)\n"],"execution_count":29,"outputs":[{"output_type":"stream","name":"stdout","text":["Custom GPT-2 model initialized successfully with 124,439,808 parameters!\n"]}]},{"cell_type":"markdown","metadata":{"id":"f383d321"},"source":["## Load Pre-trained Weights\n","\n","### Subtask:\n","Download and map official OpenAI GPT-2 124M weights into the custom model architecture parameter-by-parameter.\n"]},{"cell_type":"markdown","metadata":{"id":"f6f9753e"},"source":["**Reasoning**:\n","We will download the pre-trained weights from Hugging Face GPT-2 (124M) using the transformers library, map and transpose the Conv1D weights to our standard nn.Linear layers, and load them into our custom GPT-2 architecture.\n","\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":284,"referenced_widgets":["f373906c8a5e4bb98f843558fa98e9ef","d6fd95888c1d4c37964a4a4180dac636","34f773287af041febcb9aa139c9efe20","50018e8462244adfa46cecf9a8e82e4c","4ded72d1b9f442e3bb84602d1c2cb216","ca9a8e821897430d830e53cd7b17d1a0","7b39e6ea10954ad1a39365562468946b","8f5fce60ad6c408eb569f9e47a6b7797","ac72d8e5609f