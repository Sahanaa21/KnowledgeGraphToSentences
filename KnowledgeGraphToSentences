nd_xml_files(challenge_2017_path)\n","\n","train_files = [f for f in all_xml_files if \"train\" in f.lower()]\n","dev_files = [f for f in all_xml_files if \"dev\" in f.lower() or \"val\" in f.lower()]\n","test_files = [f for f in all_xml_files if \"test\" in f.lower()]\n","\n","def parse_webnlg_xml(file_paths):\n","    data = []\n","    for file_path in file_paths:\n","        try:\n","            tree = ET.parse(file_path)\n","            root = tree.getroot()\n","            for entry in root.findall(\".//entry\"):\n","                category = entry.attrib.get('category', 'unknown')\n","\n","                triples = []\n","                triples_elem = entry.find('modifiedtripleset')\n","                if triples_elem is None:\n","                    triples_elem = entry.find('originaltripleset')\n","                if triples_elem is not None:\n","                    for mtriples in triples_elem.findall('otriple') + triples_elem.findall('mtriple'):\n","                        if mtriples.text:\n","                            triples.append(mtriples.text.strip())\n","\n","                lexicalizations = []\n","                for lex in entry.findall('lex'):\n","                    if lex.text:\n","                        lexicalizations.append(lex.text.strip())\n","\n","                if triples and lexicalizations:\n","                    data.append({\n","                        'category': category,\n","                        'triples': triples,\n","                        'lexicalizations': lexicalizations\n","                    })\n","        except Exception as e:\n","            print(f\"Error parsing {file_path}: {e}\")\n","    return data\n","\n","train_data = parse_webnlg_xml(train_files)\n","dev_data = parse_webnlg_xml(dev_files)\n","test_data = parse_webnlg_xml(test_files)\n","\n","print(f\"\\nSuccessfully Parsed Train Set: {len(train_data)} entries\")\n","print(f\"Successfully Parsed Dev Set: {len(dev_data)} entries\")\n","print(f\"Successf